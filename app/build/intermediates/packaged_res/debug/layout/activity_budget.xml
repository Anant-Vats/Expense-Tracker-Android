<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Info banner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimaryLight"
            android:padding="12dp"
            android:text="Set your monthly budgets below. Leave blank to skip any category."
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- Overall budget -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰  Overall Monthly Budget (₹)"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etOverallBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 15000"
            android:inputType="numberDecimal"
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:layout_marginBottom="24dp"/>

        <!-- Per-category divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category Budgets (₹)"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Dynamic category rows injected here -->
        <LinearLayout
            android:id="@+id/llCategoryBudgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Save button -->
        <Button
            android:id="@+id/btnSaveBudget"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Save Budgets"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
